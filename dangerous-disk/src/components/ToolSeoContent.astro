---
interface ToolFaq {
  q: string;
  a: string;
}

interface Props {
  heading: string;
  headingId: string;
  faqHeading: string;
  faqs: ToolFaq[];
  pageUrl: string;
  application: Record<string, unknown>;
}

const { heading, headingId, faqHeading, faqs, pageUrl, application } = Astro.props;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${pageUrl}#application`,
      ...application,
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
  ],
};
---

<section class="tool-seo-content" aria-labelledby={headingId}>
  <article class="tool-seo-prose">
    <h1 id={headingId}>{heading}</h1>
    <slot />
  </article>
</section>

<section class="tool-faq" aria-labelledby={`${headingId}-faq`}>
  <div class="tool-faq-inner">
    <h2 id={`${headingId}-faq`}>{faqHeading}</h2>
    {
      faqs.map((item) => (
        <details class="tool-faq-item">
          <summary>{item.q}</summary>
          <div class="tool-faq-answer" set:html={item.a} />
        </details>
      ))
    }
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<style>
  .tool-seo-content {
    position: relative;
    z-index: 10;
    padding: 2.5rem 1rem 3.5rem;
  }

  .tool-seo-prose {
    max-width: 72ch;
    margin: 0 auto;
    color: var(--color-ink);
    font-family: var(--font-sans);
    line-height: 1.7;
  }

  .tool-seo-prose h1 {
    margin: 0 0 1rem;
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .tool-seo-prose :global(h2) {
    margin: 1.9rem 0 0.55rem;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .tool-seo-prose :global(p) {
    margin: 0 0 1rem;
    color: var(--color-ink-soft, var(--color-ink));
  }

  .tool-seo-prose :global(ol),
  .tool-seo-prose :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.4rem;
    color: var(--color-ink-soft, var(--color-ink));
  }

  .tool-seo-prose :global(li) {
    margin: 0.35rem 0;
    padding-left: 0.2rem;
  }

  .tool-seo-prose :global(a),
  .tool-faq-answer :global(a) {
    color: var(--color-link, currentColor);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .tool-seo-prose :global(code),
  .tool-faq-answer :global(code) {
    border-radius: 0.25rem;
    background-color: var(--color-canvas-soft);
    padding: 0.05em 0.3em;
    font-family: var(--font-mono, monospace);
    font-size: 0.9em;
  }

  .tool-seo-prose :global(pre) {
    overflow-x: auto;
    margin: 0 0 1rem;
    border: 1px solid var(--color-hairline, var(--color-divider));
    border-radius: 0.5rem;
    background-color: var(--color-canvas);
    padding: 1rem;
  }

  .tool-seo-prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .tool-faq {
    position: relative;
    z-index: 10;
    padding: 0 1rem 4rem;
  }

  .tool-faq-inner {
    max-width: 72ch;
    margin: 0 auto;
  }

  .tool-faq-inner h2 {
    margin: 0 0 1.25rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .tool-faq-item {
    overflow: hidden;
    margin-bottom: 0.625rem;
    border: 1px solid var(--color-hairline, var(--color-divider));
    border-radius: 0.5rem;
    background-color: var(--color-canvas);
  }

  .tool-faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    cursor: pointer;
    list-style: none;
    padding: 0.875rem 1rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
  }

  .tool-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .tool-faq-item summary::after {
    content: '+';
    color: var(--color-mute, var(--color-ink-soft));
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1;
  }

  .tool-faq-item[open] summary::after {
    content: '−';
  }

  .tool-faq-item summary:hover {
    background-color: var(--color-canvas-soft);
  }

  .tool-faq-item summary:focus-visible {
    outline: 2px solid var(--color-link, currentColor);
    outline-offset: -2px;
  }

  .tool-faq-answer {
    padding: 0 1rem 1rem;
    color: var(--color-ink-soft, var(--color-ink));
    font-family: var(--font-sans);
    line-height: 1.65;
  }

  .tool-faq-answer :global(p) {
    margin: 0;
  }

  @media (min-width: 768px) {
    .tool-seo-prose h1 {
      font-size: 2.125rem;
    }
  }
</style>
